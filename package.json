{
  "name": "bookmyshow-backend",
  "version": "1.0.0",
  "description": "Production-grade BookMyShow entertainment ticket booking backend engine",
  "main": "src/main.ts",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun run --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/infrastructure/database/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@elysiajs/apollo": "^1.4.1",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "graphql": "^17.0.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
